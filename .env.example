# Copy this to .env.local and fill in real values. Never commit .env.local.

# Supabase — Project Settings -> API in the Supabase dashboard.
# NEXT_PUBLIC_* values are safe to expose to the browser; the service role
# key must NEVER be prefixed with NEXT_PUBLIC_ or used in client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production site URL — used for Open Graph/Twitter metadata
# (src/app/layout.tsx), sitemap.xml, and robots.txt. Leave unset in local
# dev; set to the real production domain (e.g. https://ftkathletics.com)
# once it's connected.
NEXT_PUBLIC_SITE_URL=

# Resend — used to email info@ftkathletics.com when a parent requests a
# cancellation (src/app/api/cancellation-requests/route.ts). Separate from
# any Resend SMTP credentials configured in the Supabase dashboard for auth
# emails — this is a dedicated API key for the Resend HTTP API, from
# resend.com/api-keys. Server-only, never exposed to the browser.
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend. Leave unset to
# fall back to Resend's onboarding@resend.dev test sender.
RESEND_FROM_EMAIL=

# Stripe — dashboard.stripe.com/apikeys and dashboard.stripe.com/webhooks.
# Use TEST MODE keys (sk_test_.../whsec_... from a test-mode webhook
# endpoint) until live payments are explicitly approved — never mix a
# sk_live_ key with a test webhook secret or vice versa. Both server-only,
# never exposed to the browser (src/lib/stripe.ts, src/app/api/webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
