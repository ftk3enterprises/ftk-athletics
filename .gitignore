# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler
cloudflare-env.d.ts

# supabase CLI local cache
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
.vinext/

# raw video sources — original camera/phone exports, never web-optimized
# and often over Cloudflare's 25 MiB per-asset limit. Keep these outside
# public/ entirely; only the optimized public/videos/*.mp4 ships.
/local-media-source/
